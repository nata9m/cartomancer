{
  "name": "cartomancer",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted geography trainer — capitals, countries, flags",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @cartomancer/db migrate:dev",
    "db:deploy": "pnpm --filter @cartomancer/db migrate:deploy",
    "db:seed": "pnpm --filter @cartomancer/db seed",
    "db:generate": "pnpm --filter @cartomancer/db generate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  }
}
