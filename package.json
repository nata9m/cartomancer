{
  "name": "cartomancer",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted geography trainer — capitals, countries, flags",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tooling.json",
    "db:migrate": "pnpm --filter @cartomancer/db migrate:dev",
    "db:deploy": "pnpm --filter @cartomancer/db migrate:deploy",
    "db:seed": "pnpm --filter @cartomancer/db seed",
    "db:generate": "pnpm --filter @cartomancer/db generate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css}\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "vitest": "^3.2.7"
  }
}
