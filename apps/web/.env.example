# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public origin of the web app. Required in production so OAuth callbacks and
# cookies resolve; not needed for `next dev` on localhost.
AUTH_URL="https://cartomancer.ktmb1.net"

# Set to true in the cluster: the app sits behind a Gateway, so the Host header
# is what identifies the origin. Auth.js stays at its DEFAULT basePath
# (/api/auth) — the Gateway routes that prefix back to this service.
AUTH_TRUST_HOST="true"

# Google: console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID (type "Web application"). Authorised redirect URI:
#   https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple: developer.apple.com → Certificates, Identifiers & Profiles.
# AUTH_APPLE_ID is the Services ID (e.g. com.example.cartomancer.web), with
#   https://<host>/api/auth/callback/apple registered as a Return URL.
# AUTH_APPLE_TEAM_ID is the 10-character team id; AUTH_APPLE_KEY_ID is the id of
# a "Sign in with Apple" private key, and AUTH_APPLE_PRIVATE_KEY is that key's
# PEM contents (literal \n escapes are accepted, so it fits on one line).
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""

# ─── Backend ──────────────────────────────────────────────────────────────────
# In-cluster URL of apps/api, used by server-side rendering and by the /bff
# proxy. The browser never calls the api directly, so this is the only address
# that has to resolve; in the cluster it is http://cartomancer-api:8080.
API_INTERNAL_URL="http://localhost:8080"

# Shared secret, must match the api's INTERNAL_API_KEY. NOT in the deployment
# contract's env list — see the README's "Deployment contract" section: the api
# is publicly routed at /api, so without this it would trust any caller's
# user-id header.
INTERNAL_API_KEY=""

# ─── Database ─────────────────────────────────────────────────────────────────
# Used only by the Auth.js Prisma adapter (users/accounts). All quiz data access
# goes through the api.
DATABASE_URL="postgresql://cartomancer:cartomancer@localhost:5432/cartomancer?schema=public"

# Next.js listens on this port; 3000 by default.
PORT="3000"

# Timezone for the container. The day-streak buckets are computed in the
# browser's timezone, which the app passes to the api, so this only affects logs.
TZ="Etc/UTC"
