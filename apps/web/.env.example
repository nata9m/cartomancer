# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public origin of the web app. Required in production so OAuth callbacks and
# cookies resolve; not needed for `next dev` on localhost.
AUTH_URL="https://cartomancer.example.com"

# Google: console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID (type "Web application"). Authorised redirect URI:
#   https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple: developer.apple.com → Certificates, Identifiers & Profiles.
# AUTH_APPLE_ID is the Services ID (e.g. com.example.cartomancer.web), with
#   https://<host>/api/auth/callback/apple registered as a Return URL.
# AUTH_APPLE_TEAM_ID is the 10-character team id; AUTH_APPLE_KEY_ID is the id of
# a "Sign in with Apple" private key, and AUTH_APPLE_PRIVATE_KEY is that key's
# PEM contents (literal \n escapes are accepted, so it fits on one line).
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""

# ─── Backend ──────────────────────────────────────────────────────────────────
# Internal URL of apps/api. The browser never calls it directly — every request
# is proxied by /api/bff/* so the shared secret stays server-side.
API_BASE_URL="http://localhost:8080"

# Must match the api's INTERNAL_API_KEY.
INTERNAL_API_KEY=""

# ─── Database ─────────────────────────────────────────────────────────────────
# Used only by the Auth.js Prisma adapter (users/accounts). All quiz data access
# goes through the api.
DATABASE_URL="postgresql://cartomancer:cartomancer@localhost:5432/cartomancer?schema=public"

# Next.js listens on this port; 3000 by default.
PORT="3000"
