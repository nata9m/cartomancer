# Postgres connection used by Prisma.
DATABASE_URL="postgresql://cartomancer:cartomancer@localhost:5432/cartomancer?schema=public"

# Connection pool (#62). All three are optional; leave them commented out to get
# the defaults. Each pod holds at most DATABASE_POOL_MAX connections, so the
# budget across the system is replicas x max for each app, plus migrations and
# admin access, and it has to stay under Postgres's max_connections (100 unless
# changed). See "Database connections" in the README before raising any of these.
#   DATABASE_POOL_MAX                 api default 10 (web default 3)
#   DATABASE_POOL_IDLE_TIMEOUT_MS     default 30000: close a connection left unused this long
#   DATABASE_POOL_CONNECTION_TIMEOUT_MS  default 5000: fail a request after waiting this
#                                     long for a free connection (503), rather than hanging
# DATABASE_POOL_MAX="10"
# DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
# DATABASE_POOL_CONNECTION_TIMEOUT_MS="5000"

# Bind address and port. The container defaults to 0.0.0.0:8080.
HOST="0.0.0.0"
PORT="8080"

# Shared secret the web app sends as `Authorization: Bearer …`, along with the
# signed-in user's id. Leave empty in local dev to disable the check (the api
# logs a warning at boot and carries on). REQUIRED in the cluster, where the
# Gateway routes /api here from the public hostname — without it the api would
# accept any caller's x-cartomancer-user-id header, so with NODE_ENV=production
# an empty value makes the api refuse to start rather than fail open. Flagged in
# the README because it is not in the deployment contract's env list.
INTERNAL_API_KEY=""

# Optional comma-separated CORS allow-list, only needed if you point a browser
# straight at the API during development.
CORS_ORIGIN=""

# 'info' in production, 'debug' while developing.
LOG_LEVEL="info"

# Timezone for the container; affects log timestamps only.
TZ="Etc/UTC"
