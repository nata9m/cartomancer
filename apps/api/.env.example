# Postgres connection used by Prisma.
DATABASE_URL="postgresql://cartomancer:cartomancer@localhost:5432/cartomancer?schema=public"

# Bind address and port. The container defaults to 0.0.0.0:8080.
HOST="0.0.0.0"
PORT="8080"

# Shared secret the web app sends as `Authorization: Bearer …`. The browser never
# talks to this service directly — apps/web proxies every call and injects this
# header along with the signed-in user's id. Leave empty in local dev to disable
# the check (the API logs a warning); set it in the cluster.
INTERNAL_API_KEY=""

# Optional comma-separated CORS allow-list, only needed if you point a browser
# straight at the API during development.
CORS_ORIGIN=""

# 'info' in production, 'debug' while developing.
LOG_LEVEL="info"
